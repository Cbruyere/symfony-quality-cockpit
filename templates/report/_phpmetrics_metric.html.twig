<twig:UxCard>
    {% set sectionIcon = {
        maintainability: 'bi:shield-check',
        complexity: 'bi:speedometer2',
        coupling: 'bi:diagram-3',
        cohesion: 'bi:bezier2',
        volume: 'bi:bar-chart',
        classes: 'bi:boxes',
        violations: 'bi:exclamation-triangle'
    } %}
    {% set icon = section is defined and sectionIcon[section] is defined ? sectionIcon[section] : 'bi:graph-up' %}

    <div class="relative overflow-hidden">
        {{ ux_icon(icon, {class: 'pointer-events-none absolute bottom-0 right-0 h-14 w-14 text-cyan-300/5'}) }}
        <div class="relative flex items-start justify-between gap-3">
            <p class="text-sm text-zinc-400">{{ metric is defined ? metric.label : label }}</p>

            {% if section is defined and section %}
                <a
                    class="shrink-0 rounded border border-zinc-700 px-2 py-1 text-xs font-medium text-zinc-300 hover:border-cyan-400 hover:text-cyan-200"
                    href="{{ path('quality_cockpit_phpmetrics_section', {section: section}) }}"
                >
                    Detail
                </a>
            {% endif %}
        </div>

        {% set level = metric is defined ? metric.level : level|default('neutral') %}
        {% set value = metric is defined ? metric.formattedValue : value %}
        <p class="{{ level == 'success' ? 'text-green-300' : level == 'warning' ? 'text-amber-300' : level == 'danger' ? 'text-red-300' : 'text-zinc-300' }} relative mt-3 text-2xl font-semibold">{{ value }}</p>
    </div>
</twig:UxCard>

