<div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h2 class="flex items-center gap-2 text-2xl font-semibold text-white">
            {{ ux_icon('bi:shield-lock', {class: 'h-5 w-5 text-cyan-300'}) }}
            <span>Composer Audit</span>
        </h2>
    </div>

    {% if composerAuditReport.jsonReportPath %}
        <a
            class="inline-flex items-center justify-center rounded border border-zinc-700 px-3 py-2 text-sm font-medium text-zinc-200 hover:border-cyan-400 hover:text-cyan-200"
            href="{{ path('quality_cockpit_composer_audit_report', {path: composerAuditReport.jsonReportPath}) }}"
            target="_blank"
            rel="noreferrer"
        >
            Rapport JSON
        </a>
    {% endif %}
</div>

{% if composerAuditReport.available and composerAuditReport.valid %}
    <section class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        {% include '@QualityCockpit/report/_composer_audit_metric.html.twig' with {metric: composerAuditReport.vulnerabilitiesMetric} only %}
        {% include '@QualityCockpit/report/_composer_audit_metric.html.twig' with {metric: composerAuditReport.affectedPackagesMetric} only %}
        {% include '@QualityCockpit/report/_composer_audit_metric.html.twig' with {metric: composerAuditReport.abandonedPackagesMetric} only %}
        {% include '@QualityCockpit/report/_composer_audit_metric.html.twig' with {metric: composerAuditReport.statusMetric} only %}
    </section>

    <div class="mt-4 rounded border border-zinc-800 bg-zinc-900 px-5 py-4">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <p class="text-sm font-medium text-zinc-300">Generation</p>
                <p class="mt-1 text-sm text-zinc-400">
                    {% if composerAuditReport.generatedAt %}
                        {{ composerAuditReport.generatedAt|date('d/m/Y H:i') }}
                    {% else %}
                        Non renseignee
                    {% endif %}
                </p>
            </div>
            <span class="{{ composerAuditReport.freshness == 'recent' ? 'bg-green-400/10 text-green-200' : composerAuditReport.freshness == 'a regenerer' ? 'bg-amber-400/10 text-amber-200' : 'bg-zinc-700 text-zinc-200' }} rounded px-2.5 py-1 text-sm font-medium">
                {{ composerAuditReport.freshness }}
            </span>
        </div>
    </div>

    <details class="mt-4 rounded border border-zinc-800 bg-zinc-900" open>
        <summary class="flex cursor-pointer flex-col gap-2 px-5 py-4 text-left sm:flex-row sm:items-center sm:justify-between">
            <span class="block text-lg font-semibold text-white">Vulnerabilites connues</span>
            {% include '@QualityCockpit/components/quality_status_badge.html.twig' with {severity: assessment.severity, label: composerAuditReport.advisories|length ~ ' vulnérabilité' ~ (composerAuditReport.advisories|length == 1 ? '' : 's')} only %}
        </summary>

        <div class="overflow-x-auto border-t border-zinc-800">
            <table class="w-full min-w-[1240px] text-left text-sm">
                <thead class="border-b border-zinc-800 text-xs uppercase text-zinc-500">
                    <tr>
                        <th class="px-5 py-3 font-medium">Package</th>
                        <th class="px-5 py-3 font-medium">Version installee</th>
                        <th class="px-5 py-3 font-medium">Advisory</th>
                        <th class="px-5 py-3 font-medium">CVE</th>
                        <th class="px-5 py-3 font-medium">Severite</th>
                        <th class="px-5 py-3 font-medium">Versions affectees</th>
                        <th class="px-5 py-3 font-medium">Publication</th>
                        <th class="px-5 py-3 font-medium">Statut</th>
                        <th class="px-5 py-3 font-medium">Reference</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800">
                    {% for advisory in composerAuditReport.advisories %}
                        <tr class="hover:bg-zinc-800/60">
                            <td class="px-5 py-4">
                                <a
                                    class="break-all font-medium text-white hover:text-cyan-200"
                                    href="{{ path('quality_cockpit_composer_audit_advisory_detail', {id: advisory.id}) }}"
                                >
                                    {{ advisory.packageName }}
                                </a>
                            </td>
                            <td class="px-5 py-4 text-zinc-300">{{ advisory.installedVersion }}</td>
                            <td class="px-5 py-4">
                                <p class="font-medium text-zinc-200">{{ advisory.advisoryId }}</p>
                                <p class="mt-1 line-clamp-2 text-xs text-zinc-500">{{ advisory.title }}</p>
                            </td>
                            <td class="px-5 py-4 text-zinc-300">{{ advisory.cveLabel() }}</td>
                            <td class="px-5 py-4">
                                {% if advisory.severityLevel == 'danger' %}
                                    <twig:UxBadge variant="danger" label="{{ advisory.severity }}" />
                                {% elseif advisory.severityLevel == 'warning' %}
                                    <twig:UxBadge variant="warning" label="{{ advisory.severity }}" />
                                {% else %}
                                    <twig:UxBadge label="{{ advisory.severity == 'unknown' ? 'Non renseignee' : advisory.severity }}" />
                                {% endif %}
                            </td>
                            <td class="px-5 py-4 text-zinc-300">{{ advisory.affectedVersions }}</td>
                            <td class="px-5 py-4 text-zinc-300">{{ advisory.publishedAt ? advisory.publishedAt|date('d/m/Y') : 'Non renseignee' }}</td>
                            <td class="px-5 py-4 text-zinc-300">{{ advisory.status ?: 'Vulnerable' }}</td>
                            <td class="px-5 py-4">
                                {% if advisory.link %}
                                    <a class="text-cyan-200 hover:text-cyan-100" href="{{ advisory.link }}" target="_blank" rel="noopener noreferrer">Ouvrir</a>
                                {% else %}
                                    <span class="text-zinc-500">Non renseignee</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td class="px-5 py-6 text-sm text-zinc-400" colspan="9">
                                Aucune vulnerabilite connue detectee par Composer Audit.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </details>

    <details class="mt-4 rounded border border-zinc-800 bg-zinc-900">
        <summary class="flex cursor-pointer flex-col gap-2 px-5 py-4 text-left sm:flex-row sm:items-center sm:justify-between">
            <span class="block text-lg font-semibold text-white">Packages abandonnes</span>
            <span class="{{ composerAuditReport.abandonedPackages|length > 0 ? 'bg-amber-400/10 text-amber-200' : 'bg-green-400/10 text-green-200' }} rounded px-2.5 py-1 text-sm font-medium">
                {{ composerAuditReport.abandonedPackages|length }} packages
            </span>
        </summary>

        <div class="overflow-x-auto border-t border-zinc-800">
            <table class="w-full min-w-[760px] text-left text-sm">
                <thead class="border-b border-zinc-800 text-xs uppercase text-zinc-500">
                    <tr>
                        <th class="px-5 py-3 font-medium">Package</th>
                        <th class="px-5 py-3 font-medium">Version installee</th>
                        <th class="px-5 py-3 font-medium">Remplacement recommande</th>
                        <th class="px-5 py-3 font-medium">Statut</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800">
                    {% for package in composerAuditReport.abandonedPackages %}
                        <tr class="hover:bg-zinc-800/60">
                            <td class="px-5 py-4 font-medium text-white">{{ package.name }}</td>
                            <td class="px-5 py-4 text-zinc-300">{{ package.installedVersion }}</td>
                            <td class="px-5 py-4 text-zinc-300">{{ package.replacement ?: 'Aucun remplacement indique' }}</td>
                            <td class="px-5 py-4">
                                <twig:UxBadge variant="{{ package.vulnerable ? 'danger' : 'warning' }}" label="{{ package.statusLabel() }}" />
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td class="px-5 py-6 text-sm text-zinc-400" colspan="4">
                                Aucun package abandonne signale par Composer Audit.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </details>
{% else %}
    <section class="mt-5 rounded border border-zinc-800 bg-zinc-900 p-6">
        <h3 class="text-lg font-semibold text-white">Aucun rapport Composer Audit disponible</h3>
        <p class="mt-2 text-sm text-zinc-300">
            Genere un rapport JSON Composer Audit dans le sous-dossier configure, puis recharge cette page.
        </p>
    </section>
{% endif %}
