<div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h2 class="flex items-center gap-2 text-2xl font-semibold text-white">{{ ux_icon('bi:bug', {class: 'h-5 w-5 text-fuchsia-300'}) }}<span>Infection</span></h2>
        <p class="mt-1 text-sm text-zinc-400">Mutation testing : la couverture indique les lignes exécutées, Infection vérifie que les tests détectent les mutations.</p>
    </div>
    <div class="flex flex-wrap gap-2">
        {% if infectionReport.htmlReportPath %}<a class="rounded border border-zinc-700 px-3 py-2 text-sm text-zinc-200 hover:border-cyan-400" href="{{ path('quality_cockpit_infection_report', {path: infectionReport.htmlReportPath}) }}" target="_blank" rel="noreferrer">Rapport HTML</a>{% endif %}
        {% if infectionReport.textReportPath %}<a class="rounded border border-zinc-700 px-3 py-2 text-sm text-zinc-200 hover:border-cyan-400" href="{{ path('quality_cockpit_infection_report', {path: infectionReport.textReportPath}) }}" target="_blank" rel="noreferrer">Log texte</a>{% endif %}
    </div>
</div>

{% if infectionReport.available and infectionReport.valid %}
    <section class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
        {% for metric in [
            ['MSI', infectionReport.metrics.percentage(infectionReport.metrics.msi), infectionReport.statusLevel()],
            ['Covered Code MSI', infectionReport.metrics.percentage(infectionReport.metrics.coveredCodeMsi), infectionReport.statusLevel()],
            ['Mutation Code Coverage', infectionReport.metrics.percentage(infectionReport.metrics.mutationCodeCoverage), 'info'],
            ['Mutants échappés', infectionReport.metrics.escaped, infectionReport.metrics.escaped > 0 ? 'danger' : 'success'],
            ['Mutants générés', infectionReport.metrics.total, 'neutral']
        ] %}
            <article class="rounded border border-zinc-800 bg-zinc-900 p-4"><p class="text-sm text-zinc-400">{{ metric[0] }}</p><p class="mt-2 text-2xl font-semibold {{ metric[2] == 'success' ? 'text-green-300' : metric[2] == 'warning' ? 'text-amber-300' : metric[2] == 'danger' ? 'text-red-500' : 'text-zinc-100' }}">{{ metric[1] }}</p></article>
        {% endfor %}
    </section>
    <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {% for metric in [['Tués', infectionReport.metrics.killed], ['Non couverts', infectionReport.metrics.notCovered], ['Erreurs / timeouts', infectionReport.metrics.errors ~ ' / ' ~ infectionReport.metrics.timeouts]] %}<div class="rounded border border-zinc-800 bg-zinc-900 px-4 py-3 text-sm"><span class="text-zinc-400">{{ metric[0] }}</span><strong class="float-right text-zinc-100">{{ metric[1] }}</strong></div>{% endfor %}
    </div>
    <p class="mt-4 rounded border border-cyan-900/60 bg-cyan-950/30 p-4 text-sm text-cyan-100">MCC mesure la part de mutants couverts. Le MSI mesure les mutants détectés parmi tous les mutants. Le Covered Code MSI mesure uniquement les mutants placés sur du code couvert.</p>
    <div class="mt-5 flex flex-wrap items-center justify-between gap-3"><h3 class="text-xl font-semibold text-white">Mutants à traiter</h3>{% include '@QualityCockpit/components/quality_status_badge.html.twig' with {severity: assessment.severity, label: assessment.qualifier} only %}</div>
    <div class="mt-3" data-controller="infection-filters"><div class="grid gap-3 sm:grid-cols-[12rem_1fr]"><label class="text-sm text-zinc-400">Statut<select class="mt-1 w-full rounded border-zinc-700 bg-zinc-900 text-zinc-100" data-infection-filters-target="status" data-action="change->infection-filters#filter"><option value="">Tous</option><option value="escaped">Escaped</option><option value="timed_out">Timeout</option><option value="error">Erreur</option><option value="not_covered">Non couvert</option></select></label><label class="text-sm text-zinc-400">Recherche classe, méthode, fichier ou mutateur<input class="mt-1 w-full rounded border-zinc-700 bg-zinc-900 text-zinc-100" type="search" placeholder="Filtrer les mutants" data-infection-filters-target="query" data-action="input->infection-filters#filter"></label></div><div class="mt-3 overflow-x-auto"><table class="w-full min-w-[920px] text-left text-sm"><thead class="border-b border-zinc-800 text-xs uppercase text-zinc-500"><tr><th class="px-3 py-3">Statut</th><th class="px-3 py-3">Classe / méthode</th><th class="px-3 py-3">Fichier</th><th class="px-3 py-3">Mutateur</th><th class="px-3 py-3">Détail</th></tr></thead><tbody class="divide-y divide-zinc-800">{% for mutant in infectionReport.mutants|filter(m => m.status != 'killed') %}<tr class="hover:bg-zinc-800/60" data-infection-filters-target="row" data-status="{{ mutant.status }}" data-search="{{ (mutant.className ~ ' ' ~ mutant.method ~ ' ' ~ mutant.location() ~ ' ' ~ mutant.mutator)|lower }}"><td class="px-3 py-3"><span class="rounded px-2 py-1 text-xs {{ mutant.statusLevel() == 'danger' ? 'bg-red-400/10 text-red-200' : mutant.statusLevel() == 'warning' ? 'bg-amber-400/10 text-amber-200' : 'bg-zinc-700 text-zinc-200' }}">{{ mutant.statusLabel() }}</span></td><td class="px-3 py-3 text-zinc-200">{{ mutant.className ?: 'Non renseignée' }}<br><span class="text-xs text-zinc-500">{{ mutant.method ?: 'Méthode non renseignée' }}</span></td><td class="px-3 py-3 font-mono text-xs text-zinc-400">{{ mutant.location() }}</td><td class="px-3 py-3 text-zinc-300">{{ mutant.mutator ?: 'Non renseigné' }}</td><td class="px-3 py-3"><a class="text-cyan-200 hover:text-cyan-100" href="{{ path('quality_cockpit_infection_mutant_detail', {id: mutant.id}) }}">Voir le détail</a></td></tr>{% endfor %}<tr data-infection-filters-target="empty" hidden><td colspan="5" class="px-3 py-6 text-zinc-400">Aucun mutant ne correspond aux filtres.</td></tr></tbody></table></div></div>
    <details class="mt-5 rounded border border-zinc-800 bg-zinc-900" open><summary class="cursor-pointer px-4 py-3 font-semibold text-white">Top 10 des classes avec des mutants échappés</summary><div class="overflow-x-auto"><table class="w-full min-w-[760px] text-left text-sm"><thead class="border-y border-zinc-800 text-xs uppercase text-zinc-500"><tr><th class="px-4 py-3">Classe</th><th class="px-4 py-3">Total</th><th class="px-4 py-3">Tués</th><th class="px-4 py-3">Échappés</th><th class="px-4 py-3">Covered MSI</th></tr></thead><tbody class="divide-y divide-zinc-800">{% for class in infectionReport.classes|slice(0, 10) %}<tr><td class="px-4 py-3 text-zinc-200">{{ class.className }}</td><td class="px-4 py-3">{{ class.total }}</td><td class="px-4 py-3 text-green-300">{{ class.killed }}</td><td class="px-4 py-3 text-red-300">{{ class.escaped }}</td><td class="px-4 py-3">{{ class.coveredCodeMsi is null ? 'n/a' : class.coveredCodeMsi|number_format(2, ',', ' ') ~ '%' }}</td></tr>{% else %}<tr><td colspan="5" class="px-4 py-5 text-zinc-400">Aucune classe mutée.</td></tr>{% endfor %}</tbody></table></div></details>
    <details class="mt-5 rounded border border-zinc-800 bg-zinc-900"><summary class="cursor-pointer px-4 py-3 font-semibold text-white">Synthèse par mutateur</summary><div class="overflow-x-auto"><table class="w-full min-w-[720px] text-left text-sm"><thead class="border-y border-zinc-800 text-xs uppercase text-zinc-500"><tr><th class="px-4 py-3">Mutateur</th><th class="px-4 py-3">Générés</th><th class="px-4 py-3">Tués</th><th class="px-4 py-3">Échappés</th><th class="px-4 py-3">Efficacité</th></tr></thead><tbody class="divide-y divide-zinc-800">{% for mutator in infectionReport.mutators %}<tr><td class="px-4 py-3 font-mono text-zinc-200">{{ mutator.mutator }}</td><td class="px-4 py-3">{{ mutator.total }}</td><td class="px-4 py-3">{{ mutator.killed }}</td><td class="px-4 py-3 text-red-300">{{ mutator.escaped }}</td><td class="px-4 py-3">{{ mutator.efficiency is null ? 'n/a' : mutator.efficiency|number_format(2, ',', ' ') ~ '%' }}</td></tr>{% endfor %}</tbody></table></div></details>
    <p class="mt-4 text-sm text-zinc-500">Généré le {{ infectionReport.generatedAt ? infectionReport.generatedAt|date('d/m/Y H:i') : 'n/a' }} · Fraîcheur : {{ infectionReport.freshness }} · Commande : <code class="text-cyan-200">make infection-report</code></p>
{% else %}<section class="mt-5 rounded border border-zinc-800 bg-zinc-900 p-6"><h3 class="text-lg font-semibold text-white">Aucun rapport Infection disponible</h3><p class="mt-2 text-sm text-zinc-300">{{ infectionReport.message }}. Lancez <code class="text-cyan-200">make infection-report</code> pour générer les rapports.</p></section>{% endif %}

