{% extends 'base.html.twig' %}
{% block title %}Mutant Infection{% endblock %}
{% block body %}<main class="mx-auto max-w-[1400px] px-4 py-8 sm:px-6 lg:px-8"><a class="text-cyan-200" href="{{ path('quality_cockpit_test_results') }}#infection">← Retour au cockpit</a><h1 class="mt-5 text-3xl font-semibold text-white">Mutant {{ mutant.statusLabel() }}</h1><div class="mt-5 grid gap-4 sm:grid-cols-2"><div class="rounded border border-zinc-800 bg-zinc-900 p-5"><p class="text-sm text-zinc-400">Classe</p><p class="mt-1 text-zinc-100">{{ mutant.className ?: 'Non renseignée' }}</p><p class="mt-4 text-sm text-zinc-400">Méthode</p><p class="mt-1 text-zinc-100">{{ mutant.method ?: 'Non renseignée' }}</p><p class="mt-4 text-sm text-zinc-400">Emplacement</p><p class="mt-1 font-mono text-sm text-zinc-200">{{ mutant.location() }}</p><p class="mt-4 text-sm text-zinc-400">Mutateur</p><p class="mt-1 font-mono text-zinc-200">{{ mutant.mutator ?: 'Non renseigné' }}</p></div><div class="rounded border border-zinc-800 bg-zinc-900 p-5"><h2 class="font-semibold text-white">Diff</h2><pre class="mt-3 max-h-[32rem] overflow-auto whitespace-pre-wrap break-words rounded bg-zinc-950 p-4 font-mono text-xs text-zinc-200">{{ mutant.diff ?: 'Diff non fourni par le rapport.' }}</pre></div></div>{% if mutant.processOutput %}<section class="mt-5 rounded border border-zinc-800 bg-zinc-900 p-5"><h2 class="font-semibold text-white">Sortie PHPUnit</h2><pre class="mt-3 max-h-[24rem] overflow-auto whitespace-pre-wrap break-words rounded bg-zinc-950 p-4 font-mono text-xs text-zinc-300">{{ mutant.processOutput }}</pre></section>{% endif %}</main>{% endblock %}

