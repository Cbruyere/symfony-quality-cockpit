{% extends 'base.html.twig' %}

{% block title %}{{ detail.packageName }} - Composer Audit{% endblock %}

{% block body %}
    <main class="mx-auto flex min-h-[calc(100vh-4rem)] w-full max-w-[1200px] flex-col gap-6 px-4 py-8 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div>
                <a class="text-sm font-medium text-cyan-200 hover:text-cyan-100" href="{{ path('quality_cockpit_test_results') }}#composer-audit">Retour au dashboard</a>
                <h1 class="mt-3 break-all text-3xl font-semibold text-white">{{ detail.packageName }}</h1>
                <p class="mt-2 text-zinc-400">{{ detail.title }}</p>
            </div>

            {% if detail.link %}
                <a
                    class="inline-flex items-center justify-center rounded border border-zinc-700 px-3 py-2 text-sm font-medium text-zinc-200 hover:border-cyan-400 hover:text-cyan-200"
                    href="{{ detail.link }}"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Reference
                </a>
            {% endif %}
        </div>

        <section class="grid gap-4 md:grid-cols-3">
            <twig:UxCard title="Package">
                <p class="break-all text-sm text-zinc-300">{{ detail.packageName }}</p>
                <p class="mt-2 text-xs text-zinc-500">Version installee : {{ detail.installedVersion }}</p>
            </twig:UxCard>
            <twig:UxCard title="Advisory">
                <p class="break-all text-sm text-zinc-300">{{ detail.advisoryId }}</p>
                <p class="mt-2 text-xs text-zinc-500">CVE : {{ detail.cveLabel() }}</p>
            </twig:UxCard>
            <twig:UxCard title="Severite">
                {% if detail.severityLevel == 'danger' %}
                    <twig:UxBadge variant="danger" label="{{ detail.severity }}" />
                {% elseif detail.severityLevel == 'warning' %}
                    <twig:UxBadge variant="warning" label="{{ detail.severity }}" />
                {% else %}
                    <twig:UxBadge label="{{ detail.severity == 'unknown' ? 'Non renseignee' : detail.severity }}" />
                {% endif %}
            </twig:UxCard>
        </section>

        <section class="rounded border border-zinc-800 bg-zinc-900">
            <div class="border-b border-zinc-800 px-5 py-4">
                <h2 class="text-lg font-semibold text-white">Details</h2>
            </div>
            <dl class="grid gap-0 divide-y divide-zinc-800 text-sm md:grid-cols-2 md:divide-x md:divide-y-0">
                <div class="space-y-4 p-5">
                    <div>
                        <dt class="text-zinc-500">Versions affectees</dt>
                        <dd class="mt-1 text-zinc-200">{{ detail.affectedVersions }}</dd>
                    </div>
                    <div>
                        <dt class="text-zinc-500">Publication</dt>
                        <dd class="mt-1 text-zinc-200">{{ detail.publishedAt ? detail.publishedAt|date('d/m/Y H:i') : 'Non renseignee' }}</dd>
                    </div>
                    <div>
                        <dt class="text-zinc-500">Source</dt>
                        <dd class="mt-1 text-zinc-200">{{ detail.sourceLabel() }}</dd>
                    </div>
                </div>
                <div class="space-y-4 p-5">
                    <div>
                        <dt class="text-zinc-500">Description</dt>
                        <dd class="mt-1 whitespace-pre-line text-zinc-200">{{ detail.description ?: 'Non renseignee' }}</dd>
                    </div>
                    <div>
                        <dt class="text-zinc-500">Commande utile</dt>
                        <dd class="mt-1">
                            <code class="block overflow-x-auto rounded bg-zinc-950 px-3 py-2 text-sm text-green-200">composer audit --format=json --no-interaction</code>
                        </dd>
                    </div>
                    <p class="text-sm text-amber-200">
                        Aucune version corrigee n'est affirmee ici sans information explicite dans le rapport Composer.
                    </p>
                </div>
            </dl>
        </section>

        <section class="rounded border border-zinc-800 bg-zinc-900">
            <div class="border-b border-zinc-800 px-5 py-4">
                <h2 class="text-lg font-semibold text-white">References</h2>
            </div>
            <div class="divide-y divide-zinc-800">
                {% for reference in detail.references %}
                    <a class="block break-all px-5 py-3 text-sm text-cyan-200 hover:bg-zinc-800/60 hover:text-cyan-100" href="{{ reference }}" target="_blank" rel="noopener noreferrer">
                        {{ reference }}
                    </a>
                {% else %}
                    <p class="px-5 py-6 text-sm text-zinc-400">Aucune reference exploitable dans le rapport.</p>
                {% endfor %}
            </div>
        </section>
    </main>
{% endblock %}

