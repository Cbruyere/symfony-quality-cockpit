<div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
        <h2 class="flex items-center gap-2 text-2xl font-semibold text-white">
            {{ ux_icon('bi:clipboard-check', {class: 'h-5 w-5 text-green-300'}) }}
            <span>PHPUnit</span>
        </h2>
    </div>
    {% if report.generatedAt %}
        <a
            class="inline-flex items-center justify-center rounded border border-zinc-700 px-3 py-2 text-sm font-medium text-zinc-200 hover:border-green-400 hover:text-green-200"
            href="{{ path('quality_cockpit_test_results_report', {path: 'index.html'}) }}"
            target="_blank"
            rel="noreferrer"
        >
            Rapport PHPUnit
        </a>
    {% endif %}
</div>

{% if report.available %}
    <section class="mt-5 grid gap-4 md:grid-cols-3">
        {% for label, item in {
            'Lignes': {metric: report.summary.lines, icon: 'bi:percent'},
            'Methodes': {metric: report.summary.methods, icon: 'bi:activity'},
            'Classes': {metric: report.summary.classes, icon: 'bi:boxes'}
        } %}
            {% set metric = item.metric %}
            <article class="relative overflow-hidden rounded border border-zinc-800 bg-zinc-900 p-5">
                {{ ux_icon(item.icon, {class: 'pointer-events-none absolute right-4 top-4 h-12 w-12 text-green-300/10'}) }}
                <p class="relative text-sm text-zinc-400">{{ label }}</p>
                <div class="mt-3 flex items-end justify-between gap-4">
                    <p class="relative text-3xl font-semibold text-white">{{ metric.percent }}</p>
                    <p class="relative text-sm text-zinc-400">{{ metric.ratio }}</p>
                </div>
                <div class="relative mt-4 h-2 overflow-hidden rounded bg-zinc-800">
                    <div
                        class="{{ metric.level == 'success' ? 'bg-green-400' : metric.level == 'warning' ? 'bg-amber-400' : 'bg-red-400' }} h-full"
                        style="width: {{ metric.percent == 'n/a' ? '0%' : metric.percent }}"
                    ></div>
                </div>
            </article>
        {% endfor %}
    </section>

    <div class="mt-4 space-y-4">
        <details class="rounded border border-zinc-800 bg-zinc-900">
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 text-left">
                <span>
                    <span class="block text-lg font-semibold text-white">Couverture incomplete</span>
                    <span class="mt-1 block text-sm text-zinc-400">
                        Genere le {{ report.generatedAt|date('d/m/Y H:i') }}
                    </span>
                </span>
                <span class="shrink-0 rounded bg-amber-400/10 px-2.5 py-1 text-sm font-medium text-amber-200">
                    {{ report.incompleteFiles|length }} fichiers a completer
                </span>
            </summary>

            <div class="overflow-x-auto border-t border-zinc-800">
                <table class="w-full min-w-[960px] text-left text-sm">
                    <thead class="border-b border-zinc-800 text-xs uppercase text-zinc-500">
                        <tr>
                            <th class="px-5 py-3 font-medium">Classe</th>
                            <th class="px-5 py-3 font-medium">Lignes</th>
                            <th class="px-5 py-3 font-medium">Methodes</th>
                            <th class="px-5 py-3 font-medium">Classes</th>
                            <th class="px-5 py-3 font-medium">Source</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-800">
                        {% for file in report.incompleteFiles %}
                            <tr class="hover:bg-zinc-800/60">
                                <td class="px-5 py-4">
                                    <a
                                        class="font-medium text-white hover:text-green-200"
                                        href="{{ path('quality_cockpit_test_results_detail', {path: file.reportPath}) }}"
                                    >
                                        {{ file.shortName }}
                                    </a>
                                    <p class="mt-1 text-xs text-zinc-500">{{ file.namespace }}</p>
                                </td>
                                <td class="px-5 py-4">
                                    {% include '@QualityCockpit/report/_coverage_metric.html.twig' with {metric: file.lines} only %}
                                </td>
                                <td class="px-5 py-4">
                                    {% include '@QualityCockpit/report/_coverage_metric.html.twig' with {metric: file.methods} only %}
                                </td>
                                <td class="px-5 py-4">
                                    {% include '@QualityCockpit/report/_coverage_metric.html.twig' with {metric: file.classes} only %}
                                </td>
                                <td class="px-5 py-4 text-xs text-zinc-500">{{ file.sourcePath }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td class="px-5 py-6 text-sm text-zinc-400" colspan="5">
                                    Toutes les classes suivies sont couvertes a 100%.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </details>

        <details class="rounded border border-zinc-800 bg-zinc-900">
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 text-left">
                <span>
                    <span class="block text-lg font-semibold text-white">Couverture complete</span>
                    <span class="mt-1 block text-sm text-zinc-400">
                        Classes a 100% masquees par defaut
                    </span>
                </span>
                <span class="shrink-0 rounded bg-green-400/10 px-2.5 py-1 text-sm font-medium text-green-200">
                    {{ report.completeFiles|length }}
                </span>
            </summary>

            <ul class="divide-y divide-zinc-800 border-t border-zinc-800">
                {% for file in report.completeFiles %}
                    <li class="flex flex-col gap-2 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
                        <div>
                            <a
                                class="font-medium text-white hover:text-green-200"
                                href="{{ path('quality_cockpit_test_results_detail', {path: file.reportPath}) }}"
                            >
                                {{ file.shortName }}
                            </a>
                            <p class="mt-1 text-xs text-zinc-500">{{ file.sourcePath }}</p>
                        </div>
                        <span class="text-sm font-medium text-green-300">{{ file.lines.percent }}</span>
                    </li>
                {% else %}
                    <li class="px-5 py-4 text-sm text-zinc-400">
                        Aucune classe n'est encore couverte a 100%.
                    </li>
                {% endfor %}
            </ul>
        </details>
    </div>
{% else %}
    <section class="mt-5 rounded border border-zinc-800 bg-zinc-900 p-6">
        <h3 class="text-lg font-semibold text-white">Aucun rapport disponible</h3>
        <p class="mt-2 text-sm text-zinc-300">
            Lance la generation du rapport de couverture, puis recharge cette page.
        </p>
        <code class="mt-4 block overflow-x-auto rounded bg-zinc-950 px-4 py-3 text-sm text-green-200">make test-coverage</code>
    </section>
{% endif %}

