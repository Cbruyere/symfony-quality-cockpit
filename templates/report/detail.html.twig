{% extends 'base.html.twig' %}

{% block title %}{{ detail.shortName }} - Couverture{% endblock %}

{% block body %}
    <main class="mx-auto flex min-h-[calc(100vh-4rem)] w-full max-w-[1600px] flex-col gap-6 px-4 py-8 sm:px-6 lg:px-8">
        <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div class="space-y-2">
                <a class="text-sm font-medium text-green-300 hover:text-green-200" href="{{ path('quality_cockpit_test_results') }}">
                    Couverture des tests
                </a>
                <h1 class="break-all text-3xl font-semibold text-white">{{ detail.shortName }}</h1>
                <p class="break-all text-sm text-zinc-400">{{ detail.className }}</p>
            </div>

            <a
                class="inline-flex items-center justify-center rounded border border-zinc-700 px-3 py-2 text-sm font-medium text-zinc-200 hover:border-green-400 hover:text-green-200"
                href="{{ path('quality_cockpit_test_results_report', {path: detail.reportPath}) }}"
                target="_blank"
                rel="noreferrer"
            >
                HTML PHPUnit
            </a>
        </div>

        <section class="grid gap-6 xl:grid-cols-[360px_minmax(0,1fr)]">
            <aside class="space-y-4">
                <section class="rounded border border-zinc-800 bg-zinc-900 p-4">
                    <h2 class="text-base font-semibold text-white">Synthese</h2>
                    <div class="mt-4 space-y-4">
                        {% for label, metric in {
                            'Lignes': detail.lines,
                            'Methodes': detail.methods,
                            'Classes': detail.classes
                        } %}
                            <div>
                                <div class="flex items-center justify-between gap-3">
                                    <span class="text-sm text-zinc-400">{{ label }}</span>
                                    <span class="{{ metric.level == 'success' ? 'text-green-300' : metric.level == 'warning' ? 'text-amber-300' : metric.level == 'danger' ? 'text-red-300' : 'text-zinc-300' }} text-sm font-semibold">
                                        {{ metric.percent }}
                                    </span>
                                </div>
                                <div class="mt-2 h-1.5 overflow-hidden rounded bg-zinc-800">
                                    <div
                                        class="{{ metric.level == 'success' ? 'bg-green-400' : metric.level == 'warning' ? 'bg-amber-400' : metric.level == 'danger' ? 'bg-red-400' : 'bg-zinc-600' }} h-full"
                                        style="width: {{ metric.percent == 'n/a' ? '0%' : metric.percent }}"
                                    ></div>
                                </div>
                                <p class="mt-1 text-right text-xs text-zinc-500">{{ metric.ratio }}</p>
                            </div>
                        {% endfor %}
                    </div>
                </section>

                <section class="rounded border border-zinc-800 bg-zinc-900">
                    <div class="border-b border-zinc-800 px-4 py-3">
                        <h2 class="text-base font-semibold text-white">Methodes</h2>
                        <p class="mt-1 text-xs text-zinc-500">{{ detail.methodsList|length }} methodes</p>
                    </div>

                    <div class="max-h-[52vh] overflow-auto">
                        {% for method in detail.methodsList %}
                            <a
                                class="block border-b border-zinc-800 px-4 py-3 hover:bg-zinc-800/70"
                                href="#line-{{ method.line }}"
                            >
                                <div class="flex items-start justify-between gap-3">
                                    <span class="font-medium text-white">{{ method.name }}</span>
                                    <span class="{{ method.lines.level == 'success' ? 'text-green-300' : method.lines.level == 'warning' ? 'text-amber-300' : method.lines.level == 'danger' ? 'text-red-300' : 'text-zinc-300' }} shrink-0 text-sm font-semibold">
                                        {{ method.lines.percent }}
                                    </span>
                                </div>
                                <p class="mt-1 truncate text-xs text-zinc-500" title="{{ method.signature }}">
                                    {{ method.signature }}
                                </p>
                                <div class="mt-3 flex items-center gap-2 text-xs text-zinc-500">
                                    <span>{{ method.lines.ratio }} lignes</span>
                                    <span class="text-zinc-700">/</span>
                                    <span>CRAP {{ method.crap }}</span>
                                </div>
                            </a>
                        {% else %}
                            <p class="px-4 py-5 text-sm text-zinc-400">Aucune methode detectee.</p>
                        {% endfor %}
                    </div>
                </section>
            </aside>

            <section class="min-w-0 overflow-hidden rounded border border-zinc-800 bg-zinc-950">
            <div class="flex flex-col gap-2 border-b border-zinc-800 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <h2 class="text-lg font-semibold text-white">Source</h2>
                    <p class="mt-1 break-all text-sm text-zinc-500">{{ detail.sourcePath }}</p>
                </div>
                <div class="flex flex-wrap gap-2 text-xs">
                    <span class="rounded bg-green-400/10 px-2 py-1 text-green-200">Couvert</span>
                    <span class="rounded bg-red-400/10 px-2 py-1 text-red-200">Non couvert</span>
                    <span class="rounded bg-zinc-800 px-2 py-1 text-zinc-300">Non executable</span>
                </div>
            </div>

            <div class="max-h-[78vh] overflow-auto bg-[#09090b] text-[13px]">
                {% for line in detail.sourceLines %}
                    <div
                        id="line-{{ line.number }}"
                        class="{{ line.level == 'success' ? 'border-l-green-400 bg-green-900/30' : line.level == 'danger' ? 'border-l-red-400 bg-red-900/40' : 'border-l-transparent' }} grid grid-cols-[4rem_minmax(0,1fr)] border-l-4 font-mono leading-5 hover:bg-zinc-800/60"
                    >
                        <a class="{{ line.level == 'success' ? 'text-green-200' : line.level == 'danger' ? 'text-red-200' : 'text-zinc-600' }} select-none border-r border-zinc-800/70 px-3 py-0 text-right text-xs hover:text-green-200" href="#line-{{ line.number }}">
                            {{ line.number }}
                        </a>
                        <pre class="{{ line.level == 'success' ? 'text-green-50' : line.level == 'danger' ? 'text-red-50' : 'text-zinc-200' }} min-w-max whitespace-pre px-3 py-0">{{ line.code }}</pre>
                    </div>
                {% endfor %}
            </div>
            </section>
        </section>
    </main>
{% endblock %}

