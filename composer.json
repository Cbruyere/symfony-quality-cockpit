{
  "name": "chrisdev/symfony-quality-cockpit",
  "description": "A reusable Symfony quality cockpit for PHPUnit, Infection, PhpMetrics, Deptrac and Composer Audit reports.",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": ["symfony", "quality", "phpunit", "infection", "phpmetrics", "deptrac", "composer-audit"],
  "authors": [{"name": "Chrisdev"}],
  "require": {
    "php": ">=8.4",
    "chrisdev/ux-components": "^1.0",
    "symfony/config": "^7.4|^8.0",
    "symfony/dependency-injection": "^7.4|^8.0",
    "symfony/framework-bundle": "^7.4|^8.0",
    "symfony/http-foundation": "^7.4|^8.0",
    "symfony/routing": "^7.4|^8.0",
    "symfony/translation": "^7.4|^8.0",
    "symfony/twig-bundle": "^7.4|^8.0",
    "symfony/yaml": "^7.4|^8.0",
    "symfony/stimulus-bundle": "^3.0",
    "symfony/ux-twig-component": "^3.1",
    "symfony/ux-icons": "^3.1",
    "twig/twig": "^3.21"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.0",
    "symfony/browser-kit": "^7.4|^8.0",
    "symfony/css-selector": "^7.4|^8.0",
    "symfony/phpunit-bridge": "^7.4|^8.0",
    "symfony/web-profiler-bundle": "^7.4|^8.0"
  },
  "autoload": {"psr-4": {"Chrisdev\\QualityCockpit\\": "src/"}},
  "autoload-dev": {"psr-4": {"Chrisdev\\QualityCockpit\\Tests\\": "tests/"}},
  "support": {"source": "https://github.com/chrisdev/symfony-quality-cockpit"},
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {"symfony": {"allow-contrib": false}},
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse",
    "lint": "php -l src/QualityCockpitBundle.php"
  }
}
